#!/usr/bin/env bash
# DJ Harmonic v8.3 — CDP robuste (attente active + notification)

DJDIR="$HOME/.djharmonic"
mkdir -p "$DJDIR"
LOG="$DJDIR/launch.log"
exec > >(tee -a "$LOG") 2>&1
echo "=== DJ Harmonic $(date) ==="

# === 1. EXTRAIRE LES MODULES JS ===
echo "" | base64 -d > "$DJDIR/p1.js"
echo "" | base64 -d > "$DJDIR/p2.js"
echo "" | base64 -d > "$DJDIR/p3.js"
echo "" | base64 -d > "$DJDIR/p4.js"

for f in p1 p2 p3 p4; do
  if [ ! -s "$DJDIR/$f.js" ]; then
    echo "ERREUR: $f.js vide"
    osascript -e 'display notification "Erreur extraction JS" with title "DJ Harmonic"'
    exit 1
  fi
done
echo "JS OK"

# === 2. VERIFIER SI PORT 9222 DEJA DISPONIBLE ===
PORT_OK=false
if curl -s --max-time 1 http://127.0.0.1:9222/json > /dev/null 2>&1; then
  echo "Port 9222 déjà actif, injection directe..."
  PORT_OK=true
fi

# === 3. SI PORT ABSENT: DÉTECTER ET LANCER LE NAVIGATEUR ===
if [ "$PORT_OK" = "false" ]; then

  # Détection automatique du navigateur (ordre de priorité)
  BROWSER_EXEC=""
  BROWSER_NAME=""

  declare -a BROWSERS=(
    "Brave Browser:/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
    "Google Chrome:/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    "Microsoft Edge:/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
    "Arc:/Applications/Arc.app/Contents/MacOS/Arc"
    "Opera:/Applications/Opera.app/Contents/MacOS/Opera"
    "Chromium:/Applications/Chromium.app/Contents/MacOS/Chromium"
    "Firefox:/Applications/Firefox.app/Contents/MacOS/firefox"
  )

  for entry in "${BROWSERS[@]}"; do
    name="${entry%%:*}"
    path="${entry#*:}"
    if [ -f "$path" ]; then
      BROWSER_NAME="$name"
      BROWSER_EXEC="$path"
      echo "Navigateur détecté : $name"
      break
    fi
  done

  if [ -z "$BROWSER_EXEC" ]; then
    echo "ERREUR: Aucun navigateur compatible trouvé"
    echo "Installez Brave, Chrome, Edge, Arc, Opera ou Firefox"
    osascript -e 'display notification "Aucun navigateur compatible (Brave/Chrome/Edge/Arc/Firefox)" with title "DJ Harmonic ✗"'
    exit 1
  fi

  echo "Arrêt de $BROWSER_NAME..."
  killall "$BROWSER_NAME" 2>/dev/null || true
  sleep 3

  echo "Lancement $BROWSER_NAME avec port debug..."
  nohup "$BROWSER_EXEC" --remote-debugging-port=9222 "https://soundcloud.com/discover" > /dev/null 2>&1 &

  # Attendre que le port 9222 soit disponible (max 45s)
  for i in $(seq 1 45); do
    sleep 1
    if curl -s --max-time 1 http://127.0.0.1:9222/json > /dev/null 2>&1; then
      echo "Port 9222 prêt après ${i}s ($BROWSER_NAME)"
      PORT_OK=true
      break
    fi
  done
fi

if [ "$PORT_OK" = "false" ]; then
  echo "ERREUR: Port 9222 non disponible après 40s"
  osascript -e 'display notification "Impossible de se connecter au navigateur — voir launch.log" with title "DJ Harmonic ✗"'
  exit 1
fi

# Donner un peu de temps pour que SoundCloud charge
sleep 3

# === 4. INJECTION CDP ===
echo "Injection CDP..."
INJECT_RESULT=$(python3 << 'PYEOF'
import socket, json, struct, urllib.request, time, os, sys

def ws_connect(host, port, path):
    sock = socket.create_connection((host, port), timeout=10)
    key = 'dGhlIHNhbXBsZSBub25jZQ=='
    req = (f"GET {path} HTTP/1.1\r\n"
           f"Host: {host}:{port}\r\n"
           "Upgrade: websocket\r\n"
           "Connection: Upgrade\r\n"
           f"Sec-WebSocket-Key: {key}\r\n"
           "Sec-WebSocket-Version: 13\r\n\r\n")
    sock.sendall(req.encode())
    resp = b''
    for _ in range(50):
        chunk = sock.recv(4096)
        resp += chunk
        if b'\r\n\r\n' in resp:
            break
    if b'101' not in resp:
        raise Exception(f'WS handshake failed: {resp[:200]}')
    return sock

def ws_send(sock, msg):
    data = msg.encode('utf-8')
    n = len(data)
    mask = bytes([0xaa, 0xbb, 0xcc, 0xdd])
    masked = bytes([data[i] ^ mask[i % 4] for i in range(n)])
    if n <= 125:
        header = bytes([0x81, 0x80 | n]) + mask
    elif n <= 65535:
        header = bytes([0x81, 0xfe]) + struct.pack('>H', n) + mask
    else:
        header = bytes([0x81, 0xff]) + struct.pack('>Q', n) + mask
    sock.sendall(header + masked)

def ws_recv(sock, timeout=15):
    sock.settimeout(timeout)
    try:
        buf = b''
        while len(buf) < 2:
            chunk = sock.recv(2 - len(buf))
            if not chunk: return None
            buf += chunk
        b2 = buf[1]
        payload_len = b2 & 0x7f
        if payload_len == 126:
            payload_len = struct.unpack('>H', sock.recv(2))[0]
        elif payload_len == 127:
            payload_len = struct.unpack('>Q', sock.recv(8))[0]
        if b2 & 0x80:
            sock.recv(4)
        data = b''
        while len(data) < payload_len:
            chunk = sock.recv(min(8192, payload_len - len(data)))
            if not chunk: break
            data += chunk
        return data.decode('utf-8', errors='replace')
    except socket.timeout:
        return 'TIMEOUT'
    except Exception as e:
        return f'RECV_ERR:{e}'

djdir = os.path.expanduser('~/.djharmonic')

# Trouver un onglet SoundCloud (ou le premier onglet page)
tabs = None
for attempt in range(8):
    try:
        resp = urllib.request.urlopen('http://127.0.0.1:9222/json', timeout=3)
        tabs = json.loads(resp.read())
        break
    except Exception as e:
        print(f'CDP tentative {attempt+1}: {e}', flush=True)
        time.sleep(2)

if not tabs:
    print('CDP FAILED')
    sys.exit(1)

sc_tab = next((t for t in tabs if 'soundcloud.com' in t.get('url','') and t.get('type')=='page'), None)
if not sc_tab:
    # Attendre que SoundCloud charge
    print('Attente SoundCloud...', flush=True)
    for _ in range(10):
        time.sleep(2)
        try:
            resp = urllib.request.urlopen('http://127.0.0.1:9222/json', timeout=3)
            tabs = json.loads(resp.read())
            sc_tab = next((t for t in tabs if 'soundcloud.com' in t.get('url','') and t.get('type')=='page'), None)
            if sc_tab:
                break
        except:
            pass

if not sc_tab:
    sc_tab = next((t for t in tabs if t.get('type')=='page'), None)

if not sc_tab:
    print('AUCUN ONGLET PAGE TROUVE')
    sys.exit(1)

print(f'Onglet: {sc_tab.get("url","?")}', flush=True)
ws_url = sc_tab.get('webSocketDebuggerUrl','')
if not ws_url:
    print('Pas de webSocketDebuggerUrl')
    sys.exit(1)

path = '/' + '/'.join(ws_url.split('/')[3:])
sock = ws_connect('127.0.0.1', 9222, path)
print('WS connecté', flush=True)

for i, part in enumerate(['p1','p2','p3','p4'], 1):
    js_file = os.path.join(djdir, f'{part}.js')
    with open(js_file, 'r', encoding='utf-8') as f:
        js = f.read()
    msg = json.dumps({"id": i, "method": "Runtime.evaluate",
                      "params": {"expression": js, "awaitPromise": False, "returnByValue": True}})
    ws_send(sock, msg)
    result = ws_recv(sock, timeout=15)
    if result and 'result' in result:
        r = json.loads(result)
        val = r.get('result',{}).get('result',{}).get('value','?')
        print(f'{part}: {val}', flush=True)
    else:
        print(f'{part}: {result}', flush=True)
    time.sleep(0.5)

sock.close()
print('INJECTION_OK', flush=True)
PYEOF
)

echo "Résultat: $INJECT_RESULT"

# === 5. FOCUS BRAVE ===
osascript -e 'tell application "Brave Browser" to activate' 2>/dev/null || true

# === 6. NOTIFICATION RÉSULTAT ===
if echo "$INJECT_RESULT" | grep -q "INJECTION_OK"; then
  echo "=== SUCCÈS ==="
  osascript -e 'display notification "Panneau de recherche chargé !" with title "DJ Harmonic ✓"'
else
  echo "=== ÉCHEC INJECTION ==="
  osascript -e 'display notification "Échec injection — voir ~/.djharmonic/launch.log" with title "DJ Harmonic ✗"'
fi
